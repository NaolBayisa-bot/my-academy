# Environment variables for local development.
# Copy to .env and adjust values as needed.
#
# JWT_SECRET is required (compose fails validation if it is not set) and must
# be a strong, randomly generated value in production.
JWT_SECRET=your_jwt_secret_here
SUPER_ADMIN_EMAIL=admin@ishub.academy
SUPER_ADMIN_PASSWORD=admin123!

# Postgres credentials passed to the db + server services. Defaults (shown
# here) are used when unset; override per-environment.
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_pass
POSTGRES_DB=academy_lms

