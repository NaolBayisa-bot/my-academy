# npm config to handle flaky/transient network timeouts to the registry.
# These let npm retry tarball downloads more aggressively instead of failing
# the whole install with ETIMEDOUT.
fetch-retries=6
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
network-timeout=600000
# Skip the npm audit request (a common source of spurious ETIMEDOUT).
audit=false
